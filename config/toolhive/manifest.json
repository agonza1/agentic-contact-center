{
  "policyVersion": "toolhive-demo-v1",
  "toolhiveVersion": "v0.40.0",
  "policyFile": "authorization.cedar",
  "webhook": {
    "name": "acc-approval-validator",
    "failurePolicy": "fail",
    "purpose": "Validate call, approval, offer, expiration, consumption, and idempotency state before mutating ACC retention state."
  },
  "principals": {
    "voice_agent": {
      "allowedTools": ["retention.lookup_options", "operator.request_approval"],
      "forbiddenTools": ["retention.apply_offer"]
    },
    "operator": {
      "allowedTools": ["retention.lookup_options", "operator.request_approval", "retention.apply_offer"]
    }
  },
  "retentionBoundary": {
    "discountPercentMax": 10
  }
}
