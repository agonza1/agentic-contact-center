<include>
  <extension name="agentic_contact_center_signalwire_pstn">
    <condition field="destination_number" expression="^(__SIGNALWIRE_TO_NUMBER_PATTERN__|8600|acc)$">
      <action application="set" data="acc_route=signalwire_live"/>
      <action application="set" data="acc_signalwire_ready=true"/>
      <action application="set" data="acc_signalwire_from_number=__SIGNALWIRE_FROM_NUMBER_SAFE__"/>
      <action application="set" data="acc_public_sip_host=__FREESWITCH_PUBLIC_SIP_HOST_SAFE__"/>
      <action application="set" data="hangup_after_bridge=false"/>
      <action application="set" data="acc_return_audio=pipecat_verto_webrtc"/>
      <action application="set" data="acc_media_bridge=pipecat_verto_agent_leg"/>
      <action application="set" data="absolute_codec_string=opus,PCMU"/>
      <action application="bridge" data="${verto_contact(acc-pipecat@$${domain})}"/>
    </condition>
  </extension>
</include>
