<include>
  <extension name="agentic_contact_center_local_sip_openai_8600">
    <condition field="destination_number" expression="^(8600|acc)$">
      <action application="answer"/>
      <action application="set" data="acc_route=local_sip"/>
      <action application="set" data="acc_destination_number=8600"/>
      <action application="set" data="acc_conversation_mode=openai_llm"/>
      <action application="set" data="acc_signalwire_ready=true"/>
      <action application="set" data="hangup_after_bridge=false"/>
      <action application="set" data="acc_return_audio=pipecat_verto_webrtc"/>
      <action application="set" data="acc_media_bridge=pipecat_verto_agent_leg"/>
      <action application="set" data="acc_linked_sip_call_id=${uuid}"/>
      <action application="set" data="acc_proof_sip_call_id=${sip_h_X-ACC-Proof-Call-ID}"/>
      <action application="export" data="nolocal:acc_linked_sip_call_id=${uuid}"/>
      <action application="export" data="nolocal:sip_h_X-ACC-Proof-Call-ID=${sip_h_X-ACC-Proof-Call-ID}"/>
      <action application="export" data="nolocal:acc_destination_number=8600"/>
      <action application="export" data="nolocal:acc_conversation_mode=openai_llm"/>
      <action application="export" data="nolocal:rtp_jitter_buffer_during_bridge=true"/>
      <action application="bridge" data="{absolute_codec_string=PCMU,origination_caller_id_name=ACC-8600,jitterbuffer_msec=60:200:20,rtp_jitter_buffer_during_bridge=true,acc_linked_sip_call_id=${uuid},sip_h_X-ACC-Proof-Call-ID=${sip_h_X-ACC-Proof-Call-ID},acc_destination_number=8600,acc_conversation_mode=openai_llm,sip_h_X-ACC-Destination=8600,sip_h_X-ACC-Conversation-Mode=openai_llm}${verto_contact(acc-pipecat@$${domain})}"/>
    </condition>
  </extension>
